; ART-RESET-01: image-free status entry. No legacy autoload or save access.
config_version=5

[application]
config/name="AFFIX ZERO - Art Reset"
run/main_scene="res://art_reset/reset_notice.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="AFFIX_ZERO_ART_RESET"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(1, 0.97, 0.91, 1)

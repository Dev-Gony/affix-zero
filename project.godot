; Engine configuration file.
; Best edited using the Godot editor.

config_version=5

[application]

config/name="AFFIX: ZERO"
run/main_scene="res://scenes/main.tscn"

[autoload]

GameManager="*res://scripts/autoloads/GameManager.gd"
SaveManager="*res://scripts/autoloads/SaveManager.gd"
LootManager="*res://scripts/autoloads/LootManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false
